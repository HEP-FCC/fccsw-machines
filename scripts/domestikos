#!/usr/bin/env bash
#
# domestikos - admin commands for excubitor, the GPU lock manager
#
# Named after the Domestikos ton Exkoubiton, the Byzantine officer who
# commanded the excubitores palace guard.
#
# Must be run as root. Owns the things a regular user cannot do:
#   - force-clearing another user's stale (dead-process) lock/meta files,
#     which the sticky bit on LOCK_DIR otherwise blocks (never touches a
#     lock still held by a live process -- no force-eviction of running
#     jobs, only cleanup of already-dead ones), and
#   - enforcing GPU compute mode and checking for excubitor-bypass usage
#     (see `check`), run periodically by domestikos.timer.
#
# LOCK_DIR provisioning is handled by `make install` (see
# tmpfiles.d/excubitor.conf), not by this script.
#
# Run `domestikos -h` or `domestikos <command> -h` for usage.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/excubitor-common.sh
source "${SCRIPT_DIR}/lib/excubitor-common.sh"

is_help() { [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; }

print_usage() {
    cat <<'EOF'
usage: domestikos {gc|status|check|offenders} ...

  domestikos gc                  # force-clear stale locks/meta, any user
  domestikos status               # same view as `excubitor status`
  domestikos check                # enforce EXCLUSIVE_PROCESS + log bypass usage
                                  # (used by domestikos.timer; safe to run by hand)
  domestikos offenders [<since>]  # show `check`'s bypass warnings from the
                                  # journal (default: last 24h)

Run 'domestikos <command> -h' for details on a specific command.
EOF
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        echo "ERROR: domestikos must be run as root" >&2
        exit 1
    fi
}

cmd_gc() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos gc

Force-clear stale (dead-process) lock/meta files, for any user -- the
sticky bit on LOCK_DIR otherwise blocks a regular user from clearing
anyone else's. Never touches a lock still held by a live process.
EOF
        exit 0
    fi

    require_root
    require_lock_dir
    require_gpu_count
    local cleared=0
    for gpu in $(gpu_ids); do
        local mf; mf="$(meta_file "$gpu")"
        if [[ -f "$mf" ]] && ! is_locked "$gpu"; then
            clear_meta "$gpu"
            cleared=$((cleared + 1))
        fi
    done
    echo "[domestikos] cleared ${cleared} stale lock(s)"
}

cmd_status() {
    if is_help "${1:-}"; then
        echo "usage: domestikos status"
        exit 0
    fi

    require_lock_dir
    require_gpu_count
    status
}

cmd_check() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos check

Best-effort (re-)assert `nvidia-smi -c EXCLUSIVE_PROCESS`, and log a WARN
line (see `domestikos offenders`) for any GPU excubitor considers free
but the driver shows as actively in use -- i.e. a bypass. Run
periodically by domestikos.timer; safe to run by hand any time.
EOF
        exit 0
    fi

    require_root
    require_lock_dir
    require_gpu_count

    # Best-effort, silent: re-asserting the same mode fails whenever a GPU
    # already has an active context, which is the normal steady state once
    # it's been set once -- only the very first application (at install
    # time, surfaced by `make install`) is worth flagging if it fails.
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi -c EXCLUSIVE_PROCESS >/dev/null 2>&1 || true
    fi

    # Self-heal lock file permissions: whichever user/process opens a
    # gpu*.lock first (often domestikos itself, as root, since the timer
    # starts within 5min of install -- well before any real job runs)
    # creates it with their own umask, which can leave it unwritable by
    # everyone else. open_lock_fd forces 666 on creation going forward,
    # but this repairs already-existing files from before that fix, or
    # from any other umask edge case.
    for gpu in $(gpu_ids); do
        local lf; lf="$(lock_file "$gpu")"
        [[ -e "$lf" ]] && chmod 666 "$lf" 2>/dev/null || true
    done

    for gpu in $(gpu_ids); do
        if ! is_locked "$gpu"; then
            local bypass_pids; bypass_pids="$(untracked_pids "$gpu")" || true
            if [[ -n "$bypass_pids" ]]; then
                local bypass_users; bypass_users="$(untracked_owners "$bypass_pids")" || true
                echo "WARN: GPU ${gpu} has untracked usage -- user(s)=${bypass_users} pid(s)=${bypass_pids}" >&2
            fi
        fi
    done
}

cmd_offenders() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos offenders [<since>]

Show domestikos check's bypass warnings from the systemd journal.
<since> is any journalctl --since value (default: '24 hours ago').

Examples:
  domestikos offenders
  domestikos offenders "1 hour ago"
EOF
        exit 0
    fi

    local since="${1:-24 hours ago}"
    # journalctl itself exits 1 when nothing matched -- not a real error.
    journalctl -u domestikos.service --since "${since}" -g "untracked usage" --no-pager || true
}

case "${1:-}" in
    -h|--help|help) print_usage; exit 0 ;;
    gc) shift; cmd_gc "$@" ;;
    status) shift; cmd_status "$@" ;;
    check) shift; cmd_check "$@" ;;
    offenders) shift; cmd_offenders "$@" ;;
    *)
        print_usage >&2
        exit 1
        ;;
esac
