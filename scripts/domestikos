#!/usr/bin/env bash
#
# domestikos - admin commands for excubitor, the GPU lock manager
#
# Named after the Domestikos ton Exkoubiton, the Byzantine officer who
# commanded the excubitores palace guard.
#
# Must be run as root. Owns the things a regular user cannot do:
#   - force-clearing another user's stale (dead-process) lock/meta files,
#     which the sticky bit on LOCK_DIR otherwise blocks (never touches a
#     lock still held by a live process -- no force-eviction of running
#     jobs, only cleanup of already-dead ones), and
#   - enforcing GPU compute mode and checking for excubitor-bypass usage
#     (see `check`), run periodically by domestikos.timer.
#
# LOCK_DIR provisioning is handled by `make install` (see
# tmpfiles.d/excubitor.conf), not by this script.
#
# Run `domestikos -h` or `domestikos <command> -h` for usage.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/excubitor-common.sh
source "${SCRIPT_DIR}/lib/excubitor-common.sh"

is_help() { [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; }

print_usage() {
    cat <<'EOF'
usage: domestikos {gc|status|check|offenders|usage} ...
       domestikos -v | --version

  domestikos gc                  # force-clear stale locks/meta, any user
  domestikos status               # same view as `excubitor status`
  domestikos check                # enforce EXCLUSIVE_PROCESS + log bypass usage
                                  # (used by domestikos.timer; safe to run by hand)
  domestikos offenders [<since>]  # show `check`'s bypass warnings from the
                                  # journal (default: last 24h)
  domestikos usage [<since>]      # per-user job count + total GPU-time
                                  # (default: last 7 days)

Run 'domestikos <command> -h' for details on a specific command.
EOF
}

# $1: seconds -> "HhMMmSSs".
fmt_duration() {
    local s="$1"
    printf "%dh%02dm%02ds" $((s / 3600)) $(((s % 3600) / 60)) $((s % 60))
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        echo "ERROR: domestikos must be run as root" >&2
        exit 1
    fi
}

cmd_gc() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos gc

Force-clear stale (dead-process) lock/meta files, for any user -- the
sticky bit on LOCK_DIR otherwise blocks a regular user from clearing
anyone else's. Never touches a lock still held by a live process.
EOF
        exit 0
    fi

    require_root
    require_lock_dir
    require_gpu_count
    local cleared=0
    for gpu in $(gpu_ids); do
        local mf; mf="$(meta_file "$gpu")"
        if [[ -f "$mf" ]] && ! is_locked "$gpu"; then
            clear_meta "$gpu"
            cleared=$((cleared + 1))
        fi
    done
    echo "[domestikos] cleared ${cleared} stale lock(s)"
}

cmd_status() {
    if is_help "${1:-}"; then
        echo "usage: domestikos status"
        exit 0
    fi

    require_lock_dir
    require_gpu_count
    status
}

cmd_check() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos check

Best-effort (re-)assert `nvidia-smi -c EXCLUSIVE_PROCESS`, and log a WARN
line (see `domestikos offenders`) for any bypass: a GPU excubitor
considers free but the driver shows in use, a GPU excubitor considers
locked that the driver shows in use by someone other than the lock
holder, or a GPU whose actual compute mode isn't EXCLUSIVE_PROCESS (the
assert above is silent, so this is the only way to notice it didn't
take -- e.g. it was blocked by a process already holding a context in
some other mode). Run periodically by domestikos.timer; safe to run by
hand any time.
EOF
        exit 0
    fi

    require_root
    require_lock_dir
    require_gpu_count

    # Best-effort, silent: re-asserting the same mode fails whenever a GPU
    # already has an active context, which is the normal steady state once
    # it's been set once -- only the very first application (at install
    # time, surfaced by `make install`) is worth flagging if it fails.
    if command -v nvidia-smi >/dev/null 2>&1; then
        nvidia-smi -c EXCLUSIVE_PROCESS >/dev/null 2>&1 || true
    fi

    # The assert above gives no feedback either way, so a GPU stuck
    # outside EXCLUSIVE_PROCESS (e.g. changed by someone with root, then
    # unable to be reasserted for as long as any process holds a context
    # in the wrong mode) would otherwise go unnoticed indefinitely --
    # letting multiple processes share one GPU's memory with none of the
    # bypass checks below ever tripping, since none of them rely on
    # compute mode being right in the first place. Check the actual
    # resulting mode and log it if it's still wrong.
    if command -v nvidia-smi >/dev/null 2>&1; then
        for gpu in $(gpu_ids); do
            local mode; mode="$(nvidia-smi -i "$gpu" --query-gpu=compute_mode --format=csv,noheader 2>/dev/null)" || true
            if [[ -n "$mode" && "$mode" != "Exclusive_Process" ]]; then
                echo "WARN: GPU ${gpu} compute mode is '${mode}', not Exclusive_Process -- untracked usage checks below can't be relied on until this is fixed" >&2
            fi
        done
    fi

    # Self-heal lock file permissions: whichever user/process opens a
    # gpu*.lock first (often domestikos itself, as root, since the timer
    # starts within 5min of install -- well before any real job runs)
    # creates it with their own umask, which can leave it unwritable by
    # everyone else. open_lock_fd forces 666 on creation going forward,
    # but this repairs already-existing files from before that fix, or
    # from any other umask edge case.
    for gpu in $(gpu_ids); do
        local lf; lf="$(lock_file "$gpu")"
        [[ -e "$lf" ]] && chmod 666 "$lf" 2>/dev/null || true
    done

    for gpu in $(gpu_ids); do
        if ! is_locked "$gpu"; then
            local bypass_pids; bypass_pids="$(untracked_pids "$gpu")" || true
            if [[ -n "$bypass_pids" ]]; then
                local bypass_users; bypass_users="$(untracked_owners "$bypass_pids")" || true
                echo "WARN: GPU ${gpu} has untracked usage -- user(s)=${bypass_users} pid(s)=${bypass_pids}" >&2
            fi
        else
            # Locked only proves *an* excubitor job owns this GPU, not that
            # it's the only thing running on it -- a bypasser can still
            # attach directly alongside a legitimate lock holder, and the
            # check above would never see it (it only looks at GPUs
            # excubitor considers free). Compare driver-visible process
            # owners against the lock's owner, not PIDs: the meta file
            # records excubitor's own wrapper PID ($$ in write_meta), not
            # the launched job's PID, so PIDs never match even in the
            # fully legitimate case.
            local mf; mf="$(meta_file "$gpu")"
            if [[ -f "$mf" ]]; then
                local luser; luser="$(cut -d'|' -f1 "$mf")"
                local driver_pids; driver_pids="$(untracked_pids "$gpu")" || true
                if [[ -n "$driver_pids" ]]; then
                    local driver_owners; driver_owners="$(untracked_owners "$driver_pids")" || true
                    local foreign=0 owner_arr owner
                    IFS=',' read -ra owner_arr <<< "$driver_owners"
                    for owner in "${owner_arr[@]}"; do
                        # "?" means the owner couldn't be resolved (e.g. the
                        # pid already exited between the two nvidia-smi/ps
                        # calls) -- not evidence of a foreign user, so it
                        # must not trip the warning on its own.
                        [[ "$owner" == "?" || "$owner" == "$luser" ]] && continue
                        foreign=1
                    done
                    if [[ "$foreign" -eq 1 ]]; then
                        echo "WARN: GPU ${gpu} has untracked usage -- locked by ${luser}, but driver also shows user(s)=${driver_owners} pid(s)=${driver_pids}" >&2
                    fi
                fi
            fi
        fi
    done
}

cmd_offenders() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos offenders [<since>]

Show domestikos check's bypass warnings from the systemd journal.
<since> is any journalctl --since value (default: '24 hours ago').

Examples:
  domestikos offenders
  domestikos offenders "1 hour ago"
EOF
        exit 0
    fi

    local since="${1:-24 hours ago}"
    # journalctl itself exits 1 when nothing matched -- not a real error.
    journalctl -u domestikos.service --since "${since}" -g "untracked usage" --no-pager || true
}

cmd_usage() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: domestikos usage [<since>]

Per-user job count and total GPU-time, aggregated from the USAGE records
`excubitor run` logs to the journal (tag `excubitor`) each time a job
releases its GPU(s). <since> is any journalctl --since value (default:
'7 days ago').

Examples:
  domestikos usage
  domestikos usage "30 days ago"
EOF
        exit 0
    fi

    local since="${1:-7 days ago}"
    local records
    # journalctl itself exits 1 when nothing matched -- not a real error.
    records="$(journalctl -t excubitor --since "${since}" -g '^USAGE\|' -o cat --no-pager 2>/dev/null || true)"

    if [[ -z "$records" ]]; then
        echo "No usage records found since '${since}'."
        return 0
    fi

    printf "%-12s %-8s %s\n" "USER" "JOBS" "TOTAL GPU-TIME"
    local grand_jobs=0 grand_secs=0 user jobs secs
    while read -r user jobs secs; do
        [[ -z "$user" ]] && continue
        printf "%-12s %-8s %s\n" "$user" "$jobs" "$(fmt_duration "$secs")"
        grand_jobs=$((grand_jobs + jobs))
        grand_secs=$((grand_secs + secs))
    done < <(
        awk -F'|' '{ count[$2]++; total[$2] += $4 } END { for (u in count) print u, count[u], total[u] }' <<< "$records" \
            | sort -k3 -n -r
    )
    printf "%-12s %-8s %s\n" "TOTAL" "$grand_jobs" "$(fmt_duration "$grand_secs")"
}

case "${1:-}" in
    -h|--help|help) print_usage; exit 0 ;;
    -v|--version|version) echo "domestikos ${EXCUBITOR_VERSION}"; exit 0 ;;
    gc) shift; cmd_gc "$@" ;;
    status) shift; cmd_status "$@" ;;
    check) shift; cmd_check "$@" ;;
    offenders) shift; cmd_offenders "$@" ;;
    usage) shift; cmd_usage "$@" ;;
    *)
        print_usage >&2
        exit 1
        ;;
esac
