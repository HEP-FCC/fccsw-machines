#!/usr/bin/env bash
#
# excubitor - cooperative GPU lock manager for a shared multi-GPU node
# (user commands: run / status / clean)
#
# Locks are per-GPU-index, backed by flock on files under LOCK_DIR.
# This is COOPERATIVE only: it stops nothing at the kernel/driver level.
# It only works if everyone uses this wrapper instead of launching CUDA
# jobs directly. Pair with `nvidia-smi -c EXCLUSIVE_PROCESS` as a hard
# backstop so a forgotten lock causes a crash instead of silent corruption.
#
# LOCK_DIR must already exist -- an admin provisions it via `make
# install`. See domestikos for admin-only commands (force-clearing stale
# locks left by other users, periodic bypass checking).
#
# Run `excubitor -h` or `excubitor <command> -h` for usage.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=lib/excubitor-common.sh
source "${SCRIPT_DIR}/lib/excubitor-common.sh"

DEFAULT_TIMEOUT=0   # 0 = wait forever

is_help() { [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; }

print_usage() {
    cat <<'EOF'
usage: excubitor {run|status|clean} ...
       excubitor -v | --version

  excubitor status
  excubitor run -n <num_gpus> [-t <timeout_sec>] -- <command...>
  excubitor clean

Examples:
  excubitor run -n 1 -- python train.py
  excubitor run -n 2 -t 600 -- python train_multi.py
  excubitor status

Run 'excubitor <command> -h' for details on a specific command.
EOF
}

# ---- locking -------------------------------------------------------------

# Try to acquire exactly $1 GPUs. MUST be called directly (never via
# command substitution / a pipeline) -- it must run in the caller's own
# shell process, not a subshell, because the held fds (and thus the
# flock locks) are released the instant the process holding them exits.
# On success, leaves the held gpu ids/fds in the global HELD_GPUS/HELD_FDS
# arrays for the caller to hold for the lifetime of the process.
declare -a HELD_FDS=()
declare -a HELD_GPUS=()

acquire_n() {
    local n="$1"
    local timeout="$2"
    local deadline=0
    local waiting_notice_shown=0
    if [[ "$timeout" -gt 0 ]]; then
        deadline=$(( $(date +%s) + timeout ))
    fi

    while true; do
        HELD_FDS=()
        HELD_GPUS=()
        for gpu in $(gpu_ids); do
            local lf; lf="$(lock_file "$gpu")"
            if ! open_lock_fd "$lf"; then
                echo "ERROR: cannot open lock file for GPU ${gpu} (${lf}) -- contact the administrators on Mattermost, \"FCC SW Machines\": https://mattermost.web.cern.ch/fccsw/channels/fccsw-machines" >&2
                exit 1
            fi
            if flock -n -x "$fd"; then
                HELD_FDS+=("$fd")
                HELD_GPUS+=("$gpu")
                if [[ "${#HELD_GPUS[@]}" -eq "$n" ]]; then
                    return 0
                fi
            else
                exec {fd}>&-
            fi
        done

        # not enough free GPUs right now: release what we grabbed, wait, retry
        for fd in "${HELD_FDS[@]}"; do
            flock -u "$fd"
            exec {fd}>&-
        done
        HELD_FDS=()
        HELD_GPUS=()

        if [[ "$timeout" -gt 0 && "$(date +%s)" -ge "$deadline" ]]; then
            echo "ERROR: timed out waiting for ${n} free GPU(s)" >&2
            return 1
        fi

        if [[ "$waiting_notice_shown" -eq 0 ]]; then
            if [[ "$timeout" -gt 0 ]]; then
                echo "[excubitor] no free GPU(s) right now -- waiting for ${n} to become free (timeout ${timeout}s, checking every 5s, Ctrl-C to abort)..." >&2
            else
                echo "[excubitor] no free GPU(s) right now -- waiting for ${n} to become free (checking every 5s, Ctrl-C to abort)..." >&2
            fi
            waiting_notice_shown=1
        fi

        sleep 5
    done
}

write_meta() {
    local gpu="$1"; shift
    echo "${USER}|$$|$(date '+%Y-%m-%d %H:%M:%S')|$*" > "$(meta_file "$gpu")"
}

cmd_run() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: excubitor run -n <num_gpus> [-t <timeout_sec>] -- <command...>

Acquire <num_gpus> free GPU(s) (waiting up to <timeout_sec> seconds, or
forever if omitted/0), set CUDA_VISIBLE_DEVICES for <command>, run it,
and release the GPU(s) when it exits.

Examples:
  excubitor run -n 1 -- python train.py
  excubitor run -n 2 -t 600 -- python train_multi.py
EOF
        exit 0
    fi

    require_lock_dir
    require_gpu_count

    local n=1 timeout="$DEFAULT_TIMEOUT"
    while getopts "n:t:" opt; do
        case "$opt" in
            n) n="$OPTARG" ;;
            t) timeout="$OPTARG" ;;
            *) ;;
        esac
    done
    shift $((OPTIND - 1))
    if [[ "${1:-}" == "--" ]]; then shift; fi
    if [[ "$#" -eq 0 ]]; then
        echo "usage: excubitor run -n <num_gpus> [-t <timeout_sec>] -- <command...>" >&2
        exit 1
    fi

    if ! [[ "$n" =~ ^[0-9]+$ ]] || [[ "$n" -lt 1 ]]; then
        echo "ERROR: -n must be a positive integer (got '${n}')" >&2
        exit 1
    fi
    if [[ "$n" -gt "$NUM_GPUS_TOTAL" ]]; then
        echo "ERROR: requested ${n} GPU(s) but this node only has ${NUM_GPUS_TOTAL}" >&2
        exit 1
    fi

    acquire_n "$n" "$timeout" || exit 1
    local gpu_arr=("${HELD_GPUS[@]}")

    for gpu in "${gpu_arr[@]}"; do
        write_meta "$gpu" "$*"
    done

    # not `local`: still read by cleanup() when it runs as the EXIT trap,
    # by which point cmd_run has already returned and its locals are gone.
    cvd=$(IFS=,; echo "${gpu_arr[*]}")
    run_cmd="$*"
    start_epoch=$(date +%s)
    echo "[excubitor] acquired GPU(s): ${cvd}  (user=${USER} pid=$$)"

    cleanup() {
        for fd in "${HELD_FDS[@]}"; do
            flock -u "$fd" 2>/dev/null || true
            # NB: fd was opened in acquire_n()'s scope, not this nested
            # function's -- bash's `exec {fd}>&-` name-tracking only works
            # within the scope that opened it, so close by number via eval.
            eval "exec ${fd}>&-" 2>/dev/null || true
        done
        for gpu in "${HELD_GPUS[@]}"; do
            clear_meta "$gpu"
        done
        # Best-effort usage record for `domestikos usage` -- pipe-delimited
        # so it's trivial to parse back out of `journalctl -o cat`. Never
        # let a missing/broken logger take down an otherwise-successful job.
        if command -v logger >/dev/null 2>&1; then
            local duration=$(( $(date +%s) - start_epoch ))
            logger -t excubitor "USAGE|${USER}|${cvd}|${duration}|${run_cmd}" 2>/dev/null || true
        fi
        echo "[excubitor] released GPU(s): ${cvd}"
    }
    trap cleanup EXIT INT TERM

    CUDA_VISIBLE_DEVICES="$cvd" "$@"
}

# Best-effort self-service cleanup of stale (dead-process) meta files we
# own; can't touch another user's, since LOCK_DIR is sticky -- those need
# `domestikos gc`. Prints the count cleared, as a bare number, to stdout.
self_clean() {
    local cleared=0
    for gpu in $(gpu_ids); do
        local mf; mf="$(meta_file "$gpu")"
        if [[ -f "$mf" ]] && ! is_locked "$gpu"; then
            clear_meta "$gpu"
            cleared=$((cleared + 1))
        fi
    done
    echo "$cleared"
}

cmd_status() {
    if is_help "${1:-}"; then
        echo "usage: excubitor status"
        exit 0
    fi

    require_lock_dir
    require_gpu_count
    self_clean >/dev/null
    status
}

cmd_clean() {
    if is_help "${1:-}"; then
        cat <<'EOF'
usage: excubitor clean

Clear your own stale (dead-process) lock/meta files, e.g. left behind by
a crashed job. Only removes entries you own -- LOCK_DIR is sticky, so
another user's leftovers need `domestikos gc`. Never touches a lock
still held by a live process. `status` already does this automatically;
`clean` is for when you want to be sure it happened and see the count.
EOF
        exit 0
    fi

    require_lock_dir
    require_gpu_count
    local cleared; cleared="$(self_clean)"
    echo "[excubitor] cleared ${cleared} stale lock(s) (yours only -- another user's need 'domestikos gc')"
}

case "${1:-}" in
    -h|--help|help) print_usage; exit 0 ;;
    -v|--version|version) echo "excubitor ${EXCUBITOR_VERSION}"; exit 0 ;;
    run) shift; cmd_run "$@" ;;
    status) shift; cmd_status "$@" ;;
    clean) shift; cmd_clean "$@" ;;
    *)
        print_usage >&2
        exit 1
        ;;
esac
